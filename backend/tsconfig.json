{
  "compilerOptions": {
     "types": ["node"],
       "typeRoots": ["./node_modules/@types"],
    "target": "es2022",
     "moduleResolution": "node",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
