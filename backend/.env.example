PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>
JWT_SECRET=generate_a_very_strong_random_secret_string_here

# Razorpay Configuration (Get these from razorpay.com -> Settings -> API Keys)
# Use 'rzp_live_' keys for production
RAZORPAY_KEY_ID=rzp_live_your_live_key_here
RAZORPAY_KEY_SECRET=your_live_secret_here

# Email Configuration (To send real OTPs, set up a Gmail App Password or use a service like Resend/SendGrid)
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
RESEND_API_KEY=your_resend_api_key

ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password

AI_CORE_URL=http://your_production_ai_core_url

# Meta / WhatsApp Business API
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
# Make sure to use a SYSTEM USER TOKEN for production, not a temporary one!
WHATSAPP_ACCESS_TOKEN="your_permanent_system_user_token"
